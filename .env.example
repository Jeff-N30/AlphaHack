# ---- LLMs (see KEYS.md) ----
# Default: local Ollama llama3.2 — no cloud key. brew install ollama && ollama pull llama3.2
EXTRACT_PROVIDER=ollama              # ollama | gemini | anthropic
EXTRACT_MODEL=llama3.2
OLLAMA_BASE_URL=http://127.0.0.1:11434
DRAFT_PROVIDER=ollama
DRAFT_MODEL=llama3.2
GEMINI_API_KEY=                      # optional fallback only
ANTHROPIC_API_KEY=                   # optional
LLM_TIMEOUT_S=120
MAX_PAGES_PER_DOC=4
DEMO_OFFLINE=1                       # 1 = fixtures/cache (hackathon safe). 0 = call Ollama live
PROMPT_VERSION=2                     # bump when extract prompts change (invalidates cache)

# ---- Prices for cost logging, USD per 1M tokens (update if pricing pages change) ----
PRICE_GEMINI_3_8_FLASH_IN=0.75       # through 2026-12-31; 1.50 from 2027-01-01
PRICE_GEMINI_3_8_FLASH_OUT=3.75      # through 2026-12-31; 7.50 from 2027-01-01
PRICE_CLAUDE_SONNET_5_5_IN=2.00
PRICE_CLAUDE_SONNET_5_5_OUT=10.00
PRICE_CLAUDE_HAIKU_5_5_IN=0.10       # prompts <= 100k tokens
PRICE_CLAUDE_HAIKU_5_5_OUT=0.50

# ---- Human cost baseline (replace with Gloria's real numbers) ----
OFFICER_HOURLY_USD=5.00              # ASSUMPTION, not verified
OFFICER_MINUTES_PER_FILE=45

# ---- App ----
DATA_DIR=./data                      # applicant files live here only
DATABASE_URL=sqlite:///./data/visaref.db
RETENTION_DAYS_AFTER_DECISION=7      # purge files N days after Approve / Send back
RETENTION_DAYS_IDLE=30               # purge abandoned files
FILE_ENCRYPTION_KEY=                 # optional Fernet key: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
OFFICER_NAME=Gloria
OFFICER_PIN=                         # demo login for the lock; set a real value
SESSION_SECRET=                      # any long random string
CHECKLIST_DIR=./checklists
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- Optional channels (only after the core works) ----
WHATSAPP_TOKEN=                      # Meta WhatsApp Cloud API (permanent or temp token)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=               # your own string for webhook verification
TWILIO_ACCOUNT_SID=                  # alternative: Twilio WhatsApp sandbox
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+1XXXXXXXXXX  # sandbox number shown in your Twilio console
SMTP_HOST=                           # or Gmail API; email intake/sending
SMTP_USER=
SMTP_PASSWORD=

# ---- Email intake over IMAP ----
# Gmail: enable 2-Step Verification and create an App Password.
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USER=your-address@gmail.com
EMAIL_IMAP_PASSWORD=your-16-character-app-password
EMAIL_IMAP_FOLDER=INBOX
EMAIL_SUBJECT_FILTER=VISA
EMAIL_READ_UNREAD_ONLY=true
EMAIL_POLL_INTERVAL_S=30
EMAIL_CONNECTION_TIMEOUT_S=20

# ---- Optional observability ----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
