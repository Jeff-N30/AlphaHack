# ---- LLMs: Ollama llama3.2 ONLY ----
# brew install ollama && ollama pull llama3.2 && ollama serve
EXTRACT_PROVIDER=ollama
EXTRACT_MODEL=llama3.2
OLLAMA_BASE_URL=http://127.0.0.1:11434
DRAFT_PROVIDER=ollama
DRAFT_MODEL=llama3.2
LLM_TIMEOUT_S=120
MAX_PAGES_PER_DOC=4
DEMO_OFFLINE=0
PROMPT_VERSION=9

# ---- App ----
DATA_DIR=./data
DATABASE_URL=sqlite:///./data/visaref.db
CHECKLIST_DIR=./checklists
NEXT_PUBLIC_API_URL=http://localhost:8000
OFFICER_NAME=Gloria
OFFICER_PIN=
SESSION_SECRET=
FILE_ENCRYPTION_KEY=
RETENTION_DAYS_AFTER_DECISION=7
RETENTION_DAYS_IDLE=30
OFFICER_HOURLY_USD=5.00
OFFICER_MINUTES_PER_FILE=45

# ---- Email intake (IMAP) — optional for desk seed demos ----
# Gmail: 2-Step Verification + App Password
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USER=
EMAIL_IMAP_PASSWORD=
EMAIL_IMAP_FOLDER=INBOX
EMAIL_SUBJECT_FILTER=VISA
EMAIL_READ_UNREAD_ONLY=true
EMAIL_POLL_INTERVAL_S=30
EMAIL_CONNECTION_TIMEOUT_S=20
# Outbound SMTP (Gloria confirm only — same Gmail app password works)
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
# Fallback recipient when the application has no email_sender (desk uploads)
DEMO_APPLICANT_EMAIL=
